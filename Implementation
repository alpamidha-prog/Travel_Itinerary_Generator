from prophet import Prophet
import pandas as pd
import pickle
from datetime import datetime

class CostPredictor:
    def __init__(self):
        self.model = Prophet(
            changepoint_prior_scale=0.05,
            seasonality_mode='multiplicative'
        )
        self.trained = False
    
    def prepare_data(self, historical_costs: list) -> pd.DataFrame:
        """
        Prepare data for Prophet
        historical_costs format: 
        [{"date": "2023-01-01", "cost": 150}, ...]
        """
        df = pd.DataFrame(historical_costs)
        df = df.rename(columns={"date": "ds", "cost": "y"})
        df["ds"] = pd.to_datetime(df["ds"])
        return df
    
    def train(self, historical_data: list):
        """Train the model"""
        df = self.prepare_data(historical_data)
        self.model.fit(df)
        self.trained = True
    
    def predict(self, start_date: str, end_date: str):
        """Predict costs for date range"""
        if not self.trained:
            raise ValueError("Model not trained yet")
        
        future_dates = pd.date_range(start=start_date, end=end_date)
        future_df = pd.DataFrame({"ds": future_dates})
        
        forecast = self.model.predict(future_df)
        return forecast[["ds", "yhat", "yhat_lower", "yhat_upper"]].to_dict("records")
    
    def save_model(self, path: str):
        """Save trained model"""
        with open(path, "wb") as f:
            pickle.dump(self.model, f)
    
    def load_model(self, path: str):
        """Load trained model"""
        with open(path, "rb") as f:
            self.model = pickle.load(f)
        self.trained = True`),

