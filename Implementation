import httpx
from datetime import datetime, timedelta
from app.config import settings

class WeatherService:
    BASE_URL = "https://api.openweathermap.org/data/2.5"
    
    def __init__(self):
        self.api_key = settings.OPENWEATHER_API_KEY
        self.client = httpx.AsyncClient()
    
    async def get_current_weather(self, lat: float, lon: float) -> dict:
        """Get current weather for coordinates"""
        url = f"{self.BASE_URL}/weather"
        params = {
            "lat": lat,
            "lon": lon,
            "appid": self.api_key,
            "units": "metric"
        }
        
        response = await self.client.get(url, params=params)
        return response.json()
    
    async def get_forecast(self, lat: float, lon: float, days: int = 5) -> dict:
        """Get weather forecast"""
        url = f"{self.BASE_URL}/forecast"
        params = {
            "lat": lat,
            "lon": lon,
            "appid": self.api_key,
            "units": "metric",
            "cnt": days * 8  # 3-hour intervals
        }
        
        response = await self.client.get(url, params=params)
        data = response.json()
        
        # Group by day
        forecast_by_day = {}
        for item in data.get("list", []):
            date = datetime.fromtimestamp(item["dt"]).date()
            if date not in forecast_by_day:
                forecast_by_day[date] = []
            forecast_by_day[date].append({
                "time": datetime.fromtimestamp(item["dt"]).isoformat(),
                "temp": item["main"]["temp"],
                "feels_like": item["main"]["feels_like"],
                "humidity": item["main"]["humidity"],
                "weather": item["weather"][0]["main"],
                "description": item["weather"][0]["description"],
                "icon": item["weather"][0]["icon"]
            })
        
        return {"forecast": forecast_by_day}
    
    async def close(self):
        await self.client.aclose()

weather_service = WeatherService()`),

