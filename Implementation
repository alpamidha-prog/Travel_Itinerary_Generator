        itinerary_dict["created_at"] = datetime.now()
        itinerary_dict["updated_at"] = datetime.now()
        
        doc_ref = db.collection(ItineraryDB.COLLECTION).add(itinerary_dict)
        return doc_ref[1].id
    
    @staticmethod
    def get(itinerary_id: str) -> Optional[dict]:
        """Get itinerary by ID"""
        doc = db.collection(ItineraryDB.COLLECTION).document(itinerary_id).get()
        if doc.exists:
            data = doc.to_dict()
            data["id"] = doc.id
            return data
        return None
    
    @staticmethod
    def get_user_itineraries(user_id: str) -> List[dict]:
        """Get all itineraries for a user"""
        docs = db.collection(ItineraryDB.COLLECTION)\\
            .where("user_id", "==", user_id)\\
            .order_by("created_at", direction="DESCENDING")\\
            .stream()
        
        itineraries = []
        for doc in docs:
            data = doc.to_dict()
            data["id"] = doc.id
            itineraries.append(data)
        
        return itineraries
    
    @staticmethod
    def update(itinerary_id: str, data: dict) -> bool:
