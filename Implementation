import networkx as nx
import numpy as np
from typing import List, Dict, Tuple

class RouteOptimizer:
    def __init__(self, locations: List[Dict], constraints: Dict):
        """
        locations: [{"name": "Eiffel Tower", "lat": 48.8, "lng": 2.3}, ...]
        constraints: {"max_time": 480, "max_cost": 100}
        """
        self.locations = locations
        self.constraints = constraints
        self.graph = nx.DiGraph()
        self._build_graph()
    
    def _calculate_distance(self, loc1: Dict, loc2: Dict) -> float:
        """Calculate Haversine distance between two locations"""
        lat1, lon1 = loc1["lat"], loc1["lng"]
        lat2, lon2 = loc2["lat"], loc2["lng"]
        
        R = 6371  # Earth radius in km
        
        dlat = np.radians(lat2 - lat1)
        dlon = np.radians(lon2 - lon1)
        
        a = (np.sin(dlat/2)**2 + 
             np.cos(np.radians(lat1)) * np.cos(np.radians(lat2)) * 
             np.sin(dlon/2)**2)
        c = 2 * np.arcsin(np.sqrt(a))
        
        return R * c
    
    def _build_graph(self):
        """Build weighted graph"""
        n = len(self.locations)
        
        for i in range(n):
            for j in range(n):
                if i != j:
                    distance = self._calculate_distance(
                        self.locations[i], 
                        self.locations[j]
                    )
                    
                    # Estimate travel time (km/h = 40 in city)
                    time_minutes = (distance / 40) * 60
                    
                    # Estimate cost (simplified)
                    cost = distance * 0.5  # 0.5 euros per km
                    
                    self.graph.add_edge(
                        i, j,
                        weight=time_minutes,
                        distance=distance,
                        cost=cost
                    )
    
    def optimize_route(self, start_idx: int = 0) -> List[int]:
        """
        Find optimal route using approximation algorithm
        Returns: List of location indices in visit order
        """
        try:
            # Use Christofides algorithm for TSP approximation
            route = nx.approximation.traveling_salesman_problem(
                self.graph,
                cycle=False,
                weight="weight"
            )
            return route
        except:
            # Fallback: nearest neighbor
            return self._nearest_neighbor(start_idx)
    
    def _nearest_neighbor(self, start: int) -> List[int]:
        """Greedy nearest neighbor algorithm"""
        route = [start]
        unvisited = set(range(len(self.locations))) - {start}
        current = start
        
        while unvisited:
            # Find nearest unvisited location
            nearest = min(
                unvisited,
                key=lambda x: self.graph[current][x]["weight"]
            )
            route.append(nearest)
            unvisited.remove(nearest)
            current = nearest
        
        return route
    
    def get_route_details(self, route: List[int]) -> Dict:
        """Calculate total time, distance, cost for route"""
        total_time = 0
        total_distance = 0
        total_cost = 0
        
        for i in range(len(route) - 1):
            edge = self.graph[route[i]][route[i+1]]
            total_time += edge["weight"]
            total_distance += edge["distance"]
            total_cost += edge["cost"]
        
        return {
            "route": [self.locations[i]["name"] for i in route],
            "total_time_minutes": total_time,
            "total_distance_km": total_distance,
            "total_cost": total_cost,
            "location_indices": route
        }`),

